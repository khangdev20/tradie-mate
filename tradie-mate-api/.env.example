NODE_ENV=development
PORT=3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_STORAGE_BUCKET=tradiemate-docs
DATABASE_URL=postgresql://postgres:password@localhost:5432/tradiemate

# JWT
JWT_SECRET=your-32-char-min-secret-key-goes-here

# Firebase
FIREBASE_PROJECT_ID=tradiemate-au
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tradiemate.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Stripe (AU)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AU_ACCOUNT_ID=acct_...

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-token
TWILIO_FROM_NUMBER=+61400000000

# Xero
XERO_CLIENT_ID=your-client-id
XERO_CLIENT_SECRET=your-client-secret

# Sentry
SENTRY_DSN=https://...

# ATO ABN lookup
ATO_ABN_API_GUID=your-guid

# AWS S3 (signatures & documents — Sydney region)
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=tradiemate-docs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
